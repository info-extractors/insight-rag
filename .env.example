# InsightRAG Configuration

# Application
APP_NAME=InsightRAG
APP_ENV=development
DEBUG=True
PORT=8000

# Paths
DATA_DIR=./data
INDEX_DIR=./data/index

# Retrieval Settings
DENSE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K_RETRIEVAL=15
TOP_K_RERANKED=3
RRF_K_CONSTANT=60

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# LLM Backend (Choices: qwen, mock, gemini, openai)
# 'qwen' runs local Qwen 2.5 0.5B on CPU (fits easily in 8GB RAM with no API keys)
LLM_PROVIDER=qwen
QWEN_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
GEMINI_API_KEY=
OPENAI_API_KEY=

